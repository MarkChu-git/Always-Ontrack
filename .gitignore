# Local credentials and browser-auth artifacts.
**/.env*
!**/.env.example
**/.npmrc
**/.auth/
**/playwright/.auth/
**/*storage-state*.json
**/*browser-state*.json
**/*session-state*.json
**/ontrack-cli/session.json
**/ontrack-cli/.session.json.tmp-*
**/trace.zip
**/*.trace.zip
**/*.pem
**/*.key

# GitNexus uses a local LadybugDB index and per-repository runner. It is
# reproducible from the pinned dev dependency and must not be committed.
.gitnexus/
.gitnexus-home/

# Graphify's portable core graph is committed; machine-local state is not.
graphify-out/cache/
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.needs_update
graphify-out/memory/
graphify-out/reflections/
graphify-out/20??-??-??/
.DS_Store
npm-debug.log*

# Local lightpanda binary (experimental browser provider, downloaded per machine).
/bin/lightpanda

# No HTML is committed to this repository. Generated HTML reports
# (e.g. graphify-out/graph.html) stay local and are rebuilt on demand.
*.html

# Graphify machine-local vocabulary cache (regenerated on update).
graphify-out/.vocab.txt
