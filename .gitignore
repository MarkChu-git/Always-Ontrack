node_modules/
dist/
coverage/
test-results/
playwright-report/
traces/
downloads/
always-ontrack-logo.png

# Local credentials and browser-auth artifacts.
**/.env*
!**/.env.example
**/.npmrc
**/.auth/
**/playwright/.auth/
**/*storage-state*.json
**/*browser-state*.json
**/*session-state*.json
**/ontrack-cli/session.json
**/ontrack-cli/.session.json.tmp-*
**/trace.zip
**/*.trace.zip
**/*.pem
**/*.key

# GitNexus uses a local LadybugDB index and per-repository runner. It is
# reproducible from the pinned dev dependency and must not be committed.
.gitnexus/
.gitnexus-home/

# Graphify's graph is generated per checkout (`bun run graphify:build`) and
# never committed: a committed copy put thousands of generated lines in every
# pull request and conflicted with every other one that refreshed it.
graphify-out/
.DS_Store
npm-debug.log*

# Local lightpanda binary (experimental browser provider, downloaded per machine).
/bin/lightpanda

# No HTML is committed to this repository. Generated HTML reports
# (e.g. graphify-out/graph.html) stay local and are rebuilt on demand.
*.html

# Files fetched by scripts/smoke-real.mjs against a live OnTrack session.
/downloads-smoke
