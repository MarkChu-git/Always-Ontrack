{
  "name": "ontrack-cli",
  "version": "0.5.0",
  "description": "Agent-first CLI and authentication MCP for Monash OnTrack / Doubtfire",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkChu-git/Always-Ontrack.git"
  },
  "bugs": {
    "url": "https://github.com/MarkChu-git/Always-Ontrack/issues"
  },
  "homepage": "https://github.com/MarkChu-git/Always-Ontrack#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ontrack": "./dist/cli.js",
    "ontrack-auth-mcp": "./dist/auth-mcp.js"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json && bun -e \"import { chmod } from 'node:fs/promises'; await Promise.all(['dist/cli.js', 'dist/auth-mcp.js'].map((path) => chmod(path, 0o755)))\"",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit",
    "smoke:real": "bun run build && bun scripts/smoke-real.mjs",
    "graphify:setup": "uv tool install --force --with-requirements tools/graphify-requirements.lock \"graphifyy @ https://files.pythonhosted.org/packages/f7/59/0701d592fde59db2ba9a4ab8b3fbdc5e77a9ac63159bc683fa2ef6452907/graphifyy-0.9.31-py3-none-any.whl#sha256=b0d47f823f924e7f89acfee390b9f18dc3410917617c5f6f2731bd2642abf16f\"",
    "graphify:build": "graphify extract . --code-only",
    "graphify:update": "graphify update .",
    "graphify:check": "graphify check-update .",
    "skills:check": "bun scripts/check-skill-lock.ts",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "prepare": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "ontrack",
    "doubtfire",
    "cli",
    "agent",
    "mcp"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright-core": "^1.58.2",
    "zod": "^4.0.0"
  }
}
