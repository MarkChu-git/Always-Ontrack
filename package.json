{
  "name": "ontrack-cli",
  "version": "0.4.0",
  "description": "CLI for Monash OnTrack / Doubtfire",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarkChu-git/Always-Ontrack.git"
  },
  "bugs": {
    "url": "https://github.com/MarkChu-git/Always-Ontrack/issues"
  },
  "homepage": "https://github.com/MarkChu-git/Always-Ontrack#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ontrack": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json && bun -e \"import { chmod } from 'node:fs/promises'; await chmod('dist/cli.js', 0o755)\"",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov && bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit",
    "smoke:real": "bun run build && bun scripts/smoke-real.mjs",
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "prepare": "bun run build"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "ontrack",
    "doubtfire",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "dependencies": {
    "playwright-core": "^1.58.2"
  }
}
